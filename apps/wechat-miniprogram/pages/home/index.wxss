.page,
.screen {
  width: 100%;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
}

.screen {
  position: relative;
  overflow: hidden;
  background: #102737;
  color: #fff8e9;
}

.screen-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.home-pan {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  white-space: nowrap;
}

.home-panorama {
  position: relative;
  display: inline-block;
  width: 177.78vh;
  height: 100vh;
  overflow: hidden;
}

.home-pan-image {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.home-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(5, 20, 31, .36), rgba(5, 20, 31, .08) 38%, rgba(5, 20, 31, .18) 65%, rgba(3, 15, 26, .72));
}

.topbar,
.catalog-topbar {
  position: absolute;
  z-index: 8;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 130rpx) 34rpx 18rpx;
}

.topbar { justify-content: flex-start; }
.home-leading { display: flex; align-items: center; gap: 18rpx; }
.music-control { min-width: 76rpx; padding: 10rpx 20rpx; font-size: 20rpx; }

.brand {
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  letter-spacing: .16em;
  text-shadow: 0 4rpx 18rpx rgba(0, 13, 28, .65);
}

.glass-pill,
.glass-button {
  color: #fff9ec;
  background: linear-gradient(145deg, rgba(255, 255, 255, .24), rgba(213, 240, 250, .08));
  border: 1rpx solid rgba(255, 255, 255, .42);
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, .32), 0 12rpx 36rpx rgba(0, 18, 38, .24);
  backdrop-filter: blur(18rpx);
}

.glass-pill {
  min-width: 84rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  text-align: center;
}

.home-copy {
  position: relative;
  z-index: 4;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 90rpx 38rpx 180rpx;
  text-align: center;
  text-shadow: 0 5rpx 28rpx rgba(0, 18, 30, .78);
  pointer-events: none;
}

.hero-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 78rpx;
  line-height: 1.2;
  letter-spacing: .12em;
}

.hero-title-second {
  margin-bottom: 42rpx;
}

.hero-intro {
  font-size: 28rpx;
  line-height: 1.9;
  letter-spacing: .07em;
  color: rgba(255, 247, 228, .96);
}

.begin-button {
  width: 260rpx;
  height: 96rpx;
  margin-top: 50rpx;
  padding: 0 38rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  line-height: 96rpx;
  pointer-events: auto;
}

.begin-button::after,
.build-info-button::after,
.water-toggle::after,
.back-button::after,
.story-book::after,
.retry-button::after {
  border: 0;
}

.begin-button.is-disabled {
  opacity: .5;
}

.arrow {
  font-size: 34rpx;
}

.home-footer {
  position: absolute;
  z-index: 8;
  left: 34rpx;
  right: 34rpx;
  bottom: calc(env(safe-area-inset-bottom) + 30rpx);
  display: flex;
  gap: 8px;
  align-items: center;
}

.home-pan-hint {
  position: absolute;
  z-index: 8;
  left: 50%;
  bottom: calc(env(safe-area-inset-bottom) + 104rpx);
  transform: translateX(-50%);
  width: 80%;
  color: rgba(255, 248, 228, .82);
  font-size: 21rpx;
  letter-spacing: .06em;
  text-align: center;
  text-shadow: 0 3rpx 16rpx rgba(0, 18, 34, .85);
  pointer-events: none;
}

.water-toggle {
  margin: 0;
  line-height: 1.35;
}

.api-state {
  position: absolute;
  z-index: 9;
  left: 50%;
  bottom: calc(env(safe-area-inset-bottom) + 96rpx);
  transform: translateX(-50%);
  width: 70%;
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(4, 23, 36, .64);
  border: 1rpx solid rgba(255, 255, 255, .24);
  backdrop-filter: blur(18rpx);
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.retry-button {
  display: inline-block;
  width: auto;
  margin: 12rpx 0 0;
  padding: 8rpx 26rpx;
  color: #fff6dd;
  border: 1rpx solid rgba(255, 255, 255, .42);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .14);
  font-size: 22rpx;
  line-height: 1.4;
}

.pan-water-surface {
  position: absolute;
  z-index: 2;
  left: 7%;
  right: 5%;
  bottom: 0;
  height: 49%;
  overflow: hidden;
  opacity: 0;
  transition: opacity .55s;
  mix-blend-mode: screen;
  mask-image: linear-gradient(180deg, transparent, #000 25%, #000 92%, transparent);
}

.motion-on .pan-water-surface {
  opacity: .72;
}

.pan-wave {
  position: absolute;
  left: -12%;
  width: 124%;
  height: 35%;
  border-radius: 50%;
  background: repeating-radial-gradient(ellipse at 50% 50%, transparent 0 20rpx, rgba(202, 245, 245, .38) 23rpx 26rpx, transparent 29rpx 58rpx);
  filter: blur(1rpx);
  animation: panorama-current 3.6s linear infinite;
}

.pan-wave-a { bottom: -7%; }
.pan-wave-b { bottom: 17%; opacity: .65; animation-delay: -1.2s; animation-duration: 4.6s; }
.pan-wave-c { bottom: 39%; opacity: .35; animation-delay: -2.4s; animation-duration: 5.8s; }

.pan-waterfall {
  position: absolute;
  z-index: 3;
  top: 29%;
  width: 1.35%;
  height: 25%;
  border-radius: 50%;
  opacity: 0;
  background: linear-gradient(90deg, transparent, rgba(225, 251, 248, .42) 42%, rgba(162, 224, 230, .2) 62%, transparent), repeating-linear-gradient(180deg, transparent 0 15rpx, rgba(219, 249, 247, .28) 17rpx 22rpx, transparent 24rpx 39rpx);
  filter: blur(2rpx);
  mix-blend-mode: screen;
  mask-image: linear-gradient(180deg, transparent, #000 14% 82%, transparent);
}

.waterfall-a { left: 84.8%; }
.waterfall-b { left: 89.2%; top: 22%; width: 1%; height: 27%; }
.waterfall-c { left: 94.6%; top: 16%; width: 1.6%; height: 31%; }
.motion-on .pan-waterfall { opacity: .48; animation: waterfall-stream .9s linear infinite; }

.pan-mist {
  position: absolute;
  z-index: 2;
  left: 25%;
  top: 28%;
  width: 56%;
  height: 34%;
  opacity: 0;
  background: radial-gradient(ellipse, rgba(224, 248, 242, .3), transparent 69%);
  filter: blur(22rpx);
}

.motion-on .pan-mist { opacity: .38; animation: panorama-mist 12s ease-in-out infinite alternate; }

.catalog-screen {
  min-height: 100vh;
}

.catalog-blur {
  transform: scale(1.18);
  filter: blur(34rpx) brightness(.72) saturate(.82);
}

.catalog-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(8, 30, 48, .56), rgba(9, 32, 47, .08) 32%, rgba(5, 23, 38, .56));
}

.catalog-topbar {
  align-items: flex-start;
  padding-top: calc(env(safe-area-inset-top) + 130rpx);
}

.back-button {
  width: 128rpx;
  min-width: 128rpx;
  margin: 0;
  line-height: 1.4;
}

.topbar-spacer {
  width: 128rpx;
}

.catalog-heading {
  padding-top: 4rpx;
  text-align: center;
  text-shadow: 0 4rpx 24rpx rgba(1, 19, 39, .8);
}

.catalog-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 44rpx;
  letter-spacing: .18em;
}

.catalog-subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  letter-spacing: .08em;
  color: rgba(255, 249, 231, .86);
  white-space: nowrap;
}

.atlas-scroll {
  position: absolute;
  z-index: 3;
  left: 0;
  right: 0;
  top: calc(env(safe-area-inset-top) + 252rpx);
  bottom: calc(env(safe-area-inset-bottom) + 88rpx);
  white-space: nowrap;
}

.island-atlas {
  position: relative;
  width: 2220rpx;
  height: 1250rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 36rpx;
  box-shadow: 0 28rpx 90rpx rgba(0, 18, 35, .45);
}

.atlas-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.story-book {
  position: absolute;
  z-index: 4;
  width: 164rpx;
  height: 208rpx;
  margin: 0;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 8rpx 18rpx 18rpx 8rpx;
  background: #233e43;
  box-shadow: 7rpx 8rpx 0 rgba(221, 197, 153, .74), 12rpx 12rpx 0 rgba(86, 71, 47, .7), 0 28rpx 36rpx rgba(5, 28, 42, .48);
  transform: translate(-50%, -82%) rotate(var(--book-tilt));
  transform-origin: 50% 100%;
  animation: book-float 5s ease-in-out infinite;
}

.book-1 { animation-delay: -1.7s; }
.book-2 { animation-delay: -3.4s; }

.book-art,
.book-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.book-shade {
  background: linear-gradient(180deg, rgba(7, 28, 38, .05), rgba(4, 20, 29, .14) 43%, rgba(3, 17, 25, .9));
  border: 1rpx solid rgba(255, 229, 177, .44);
}

.book-title {
  position: absolute;
  z-index: 3;
  left: 20rpx;
  right: 12rpx;
  bottom: 20rpx;
  color: #fff6dc;
  font-family: "Songti SC", "STSong", serif;
  font-size: 24rpx;
  line-height: 1.3;
  letter-spacing: .05em;
  text-align: center;
  white-space: normal;
  text-shadow: 0 2rpx 9rpx rgba(0, 0, 0, .95);
}

.scroll-spine {
  position: absolute;
  z-index: 6;
  left: -11rpx;
  top: -9rpx;
  bottom: -9rpx;
  width: 24rpx;
  border: 1rpx solid #ecd29d;
  border-radius: 14rpx;
  background: linear-gradient(90deg, #5d4128, #b89d6c 25%, #f0d9aa 48%, #ad9062 72%, #60442a);
  box-shadow: 5rpx 0 12rpx rgba(4, 21, 40, .48), inset 2rpx 0 rgba(255, 247, 216, .56);
}

.spine-cap {
  position: absolute;
  left: -5rpx;
  width: 34rpx;
  height: 15rpx;
  border-radius: 9rpx;
  border: 1rpx solid #e2bf82;
  background: linear-gradient(#e7c68f, #795431 70%, #d2a96c);
}

.spine-cap-top { top: -6rpx; }
.spine-cap-bottom { bottom: -6rpx; }

.catalog-hint {
  position: absolute;
  z-index: 8;
  left: 50%;
  bottom: calc(env(safe-area-inset-bottom) + 28rpx);
  transform: translateX(-50%);
  width: 80%;
  color: rgba(255, 247, 225, .86);
  font-size: 22rpx;
  letter-spacing: .06em;
  text-align: center;
  text-shadow: 0 3rpx 16rpx rgba(0, 18, 34, .8);
}

.story-screen {
  min-height: 100vh;
}

.reading-topbar {
  position: absolute;
  z-index: 10;
  top: calc(env(safe-area-inset-top) + 220rpx);
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 28rpx 20rpx;
}

.reading-back {
  min-width: 150rpx;
  margin: 0;
  line-height: 1.45;
}

.reading-tabs {
  display: flex;
  padding: 7rpx;
  border: 1rpx solid rgba(255, 255, 255, .38);
  border-radius: 999rpx;
  background: rgba(9, 33, 48, .36);
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, .24), 0 12rpx 34rpx rgba(0, 18, 36, .22);
  backdrop-filter: blur(18rpx);
}

.reading-tab {
  width: auto;
  min-width: 118rpx;
  margin: 0;
  padding: 13rpx 14rpx;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: rgba(255, 248, 229, .78);
  font-size: 22rpx;
  line-height: 1.35;
}

.reading-tab::after,
.reading-back::after {
  border: 0;
}

.reading-tab.is-active {
  color: #fff;
  background: linear-gradient(145deg, rgba(255, 255, 255, .42), rgba(210, 240, 249, .16));
  border: 1rpx solid rgba(255, 255, 255, .48);
}

.story-pan-scroll {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  white-space: nowrap;
}

.story-panorama {
  position: relative;
  display: inline-block;
  width: 177.78vh;
  min-width: 1500rpx;
  height: 100vh;
  overflow: hidden;
  white-space: normal;
}

.story-pan-image,
.story-pan-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.story-pan-image { filter: saturate(1.1) brightness(.93); }

.story-pan-shade {
  background: linear-gradient(90deg, rgba(2, 18, 31, .82), rgba(3, 23, 35, .56) 24%, rgba(3, 22, 34, .08) 56%, rgba(2, 15, 26, .12)), linear-gradient(180deg, rgba(3, 17, 29, .55), transparent 31%, transparent 72%, rgba(2, 17, 29, .68));
}

.story-scene-water {
  position: absolute;
  z-index: 2;
  left: 39%;
  right: -8%;
  bottom: -8%;
  height: 31%;
  opacity: .55;
  background: repeating-radial-gradient(ellipse at 50% 0, transparent 0 24rpx, rgba(199, 239, 242, .36) 26rpx 30rpx, transparent 32rpx 68rpx);
  transform: perspective(600rpx) rotateX(52deg);
  animation: story-water-current 4s linear infinite;
  mix-blend-mode: screen;
}

.reading-scroll {
  position: absolute;
  z-index: 4;
  left: 28rpx;
  top: calc(env(safe-area-inset-top) + 350rpx);
  bottom: 54rpx;
  width: 670rpx;
}

.reading-card {
  width: 100%;
  min-height: 920rpx;
  margin: 20rpx 0 92rpx;
  padding: 54rpx 42rpx 64rpx;
  border: 0;
  border-radius: 34rpx;
  background: linear-gradient(145deg, rgba(5, 27, 43, .68), rgba(5, 34, 49, .3));
  box-shadow: 0 30rpx 90rpx rgba(0, 18, 34, .42);
  backdrop-filter: blur(22rpx) saturate(1.2);
  color: #fff8e9;
}

.story-visual-caption {
  position: absolute;
  z-index: 4;
  left: 67%;
  bottom: 120rpx;
  min-width: 290rpx;
  padding: 24rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, .36);
  border-radius: 28rpx;
  background: rgba(5, 31, 44, .32);
  backdrop-filter: blur(18rpx);
  color: #fff6dc;
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
  letter-spacing: .07em;
  text-shadow: 0 3rpx 14rpx rgba(0, 14, 27, .78);
}

.visual-caption-sub {
  display: block;
  margin-top: 8rpx;
  color: rgba(224, 243, 240, .76);
  font-family: system-ui, sans-serif;
  font-size: 20rpx;
}

.story-pan-hint {
  position: absolute;
  z-index: 8;
  left: 290rpx;
  bottom: 24rpx;
  width: 600rpx;
  color: rgba(255, 246, 224, .82);
  font-size: 20rpx;
  letter-spacing: .05em;
  text-align: center;
  text-shadow: 0 3rpx 14rpx rgba(0, 15, 28, .85);
}

.reading-chapter {
  color: rgba(198, 236, 233, .88);
  font-size: 23rpx;
  letter-spacing: .1em;
}

.reading-title {
  margin: 18rpx 0 42rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 60rpx;
  line-height: 1.3;
  letter-spacing: .11em;
  text-shadow: 0 4rpx 18rpx rgba(0, 18, 31, .8);
}

.reading-state {
  padding: 70rpx 0;
  color: rgba(255, 248, 230, .9);
  font-size: 28rpx;
  line-height: 1.8;
  text-align: center;
}

.story-retry {
  margin-top: 24rpx;
}

.narrative-paragraph {
  margin-bottom: 34rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 31rpx;
  line-height: 2.05;
  letter-spacing: .035em;
  text-shadow: 0 3rpx 12rpx rgba(0, 18, 30, .82);
}

.adaptation-note {
  margin-top: 54rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .28);
  color: rgba(230, 239, 234, .78);
  font-size: 23rpx;
  line-height: 1.9;
}

.note-label {
  margin-bottom: 10rpx;
  color: #a8eee2;
  font-weight: 600;
  letter-spacing: .12em;
}

.reading-card.classic-card {
  position: relative;
  background: repeating-linear-gradient(90deg, rgba(240, 214, 166, .17) 0 45rpx, rgba(255, 236, 195, .23) 46rpx, rgba(148, 112, 63, .28) 48rpx, rgba(242, 220, 177, .15) 51rpx), linear-gradient(145deg, rgba(35, 58, 55, .72), rgba(134, 112, 70, .36));
  border-top: 10rpx solid rgba(202, 169, 105, .68);
  border-bottom: 10rpx solid rgba(202, 169, 105, .68);
}

.classic-source {
  margin-bottom: 40rpx;
  color: #f1ddae;
  font-size: 24rpx;
  letter-spacing: .14em;
}

.classic-line {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 16rpx 5rpx;
  margin-bottom: 42rpx;
}

.classic-token {
  min-width: 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.classic-token.punctuation {
  min-width: 24rpx;
}

.token-pinyin {
  min-height: 34rpx;
  color: #f0d9a7;
  font-size: 20rpx;
  line-height: 1.35;
  white-space: nowrap;
}

.token-han {
  color: #fff3d2;
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  line-height: 1.35;
  text-shadow: 0 3rpx 12rpx rgba(7, 25, 34, .72);
}

.classic-footnote {
  margin-top: 56rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 233, 190, .32);
  color: rgba(255, 235, 197, .75);
  font-size: 22rpx;
  letter-spacing: .08em;
}

.mini-theatre {
  position: absolute;
  z-index: 2;
  inset: 0;
  overflow: hidden;
  background: #102a37;
}

.theatre-scene-image,
.theatre-scene-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.theatre-scene-image { filter: saturate(1.1) brightness(.9); }
.theatre-scene-shade { background: linear-gradient(180deg, rgba(3, 19, 31, .72), transparent 28%, transparent 64%, rgba(3, 17, 29, .78)); }

.theatre-arch { position: absolute; z-index: 3; inset: 116rpx 18rpx 24rpx; pointer-events: none; }
.arch-top { position: absolute; left: 2%; right: 2%; top: 0; height: 88rpx; border-radius: 30rpx 30rpx 6rpx 6rpx; background: linear-gradient(180deg, rgba(55, 28, 24, .96), rgba(126, 68, 45, .92) 45%, rgba(199, 157, 92, .9) 48%, rgba(74, 39, 30, .94)); box-shadow: 0 16rpx 42rpx rgba(0, 11, 22, .6); }
.arch-side { position: absolute; top: 55rpx; bottom: 0; width: 50rpx; background: linear-gradient(90deg, #3d2220, #a36642 45%, #d4af6e 52%, #593128); box-shadow: 0 10rpx 34rpx rgba(0, 10, 20, .58); }
.arch-left { left: 0; }
.arch-right { right: 0; transform: scaleX(-1); }

.theatre-water {
  position: absolute;
  z-index: 4;
  left: -12%;
  right: -12%;
  bottom: -3%;
  height: 31%;
  overflow: hidden;
  pointer-events: none;
  mix-blend-mode: screen;
}

.theatre-ripple { position: absolute; left: 50%; bottom: 2%; width: 1100rpx; height: 250rpx; border: 4rpx solid rgba(199, 241, 241, .48); border-radius: 50%; transform: translateX(-50%) scale(.45); animation: theatre-ripple 3.1s linear infinite; opacity: 0; }
.ripple-b { animation-delay: -1s; }
.ripple-c { animation-delay: -2s; }

.theatre-scene-title { position: absolute; z-index: 7; left: 44rpx; top: calc(env(safe-area-inset-top) + 360rpx); color: #fff4d7; font-family: "Songti SC", "STSong", serif; font-size: 30rpx; letter-spacing: .08em; text-shadow: 0 4rpx 20rpx rgba(0, 12, 24, .9); }

.stage-act-tabs { position: absolute; z-index: 8; right: 34rpx; top: calc(env(safe-area-inset-top) + 354rpx); display: flex; gap: 10rpx; }
.stage-act-button { width: 58rpx; height: 58rpx; margin: 0; padding: 0; border: 1rpx solid rgba(255, 255, 255, .38); border-radius: 50%; background: rgba(4, 28, 42, .4); color: rgba(255, 247, 227, .82); font-size: 22rpx; line-height: 58rpx; backdrop-filter: blur(12rpx); }
.stage-act-button::after,.camera-button::after { border: 0; }
.stage-act-button.is-active { background: rgba(250, 235, 203, .9); color: #263c40; }

.stage-guide { position: absolute; z-index: 8; right: 32rpx; bottom: 42rpx; width: 390rpx; padding: 26rpx 28rpx; border: 1rpx solid rgba(255, 255, 255, .34); border-radius: 30rpx; background: rgba(5, 30, 44, .56); backdrop-filter: blur(22rpx); box-shadow: 0 20rpx 60rpx rgba(0, 14, 27, .34); }
.stage-guide-kicker { color: #9ee7df; font-size: 19rpx; letter-spacing: .14em; }
.stage-guide-action { margin-top: 10rpx; color: #fff2cf; font-family: "Songti SC", "STSong", serif; font-size: 36rpx; letter-spacing: .08em; }
.stage-guide-result { margin-top: 10rpx; color: rgba(239, 247, 239, .86); font-size: 22rpx; line-height: 1.65; }
.camera-button { width: auto; margin: 18rpx 0 0; padding: 10rpx 22rpx; border: 1rpx solid rgba(255, 255, 255, .36); border-radius: 999rpx; background: rgba(255, 255, 255, .14); color: #fff8e7; font-size: 21rpx; line-height: 1.45; }
.camera-error { margin-top: 10rpx; color: #ffd4b8; font-size: 19rpx; line-height: 1.5; }

.camera-shell { position: absolute; z-index: 9; left: 34rpx; bottom: 42rpx; width: 250rpx; height: 320rpx; overflow: hidden; border: 2rpx solid rgba(217, 242, 237, .56); border-radius: 28rpx; background: rgba(3, 20, 31, .78); box-shadow: 0 20rpx 60rpx rgba(0, 10, 22, .48); }
.hand-camera { width: 100%; height: 100%; }
.build-info-button { margin: 0 auto 0 0; padding: 8px 12px; color: #fff8e7; font-size: 13px; line-height: 1.35; }
.camera-label { position: absolute; left: 18rpx; bottom: 14rpx; padding: 6rpx 12rpx; border-radius: 999rpx; background: rgba(3, 24, 36, .66); color: #eaf7ee; font-size: 18rpx; }
.camera-crosshair { position: absolute; inset: 18rpx; border: 1rpx solid rgba(197, 240, 234, .38); border-radius: 20rpx; pointer-events: none; }
.camera-point { position: absolute; width: 12rpx; height: 12rpx; border-radius: 50%; background: #c6f4e8; box-shadow: 0 0 14rpx rgba(180, 245, 231, .82); }
.camera-point-a { left: 48%; top: 24%; }.camera-point-b { left: 28%; top: 48%; }.camera-point-c { left: 68%; top: 48%; }.camera-point-d { left: 49%; top: 72%; }

@keyframes panorama-current {
  to { transform: translateX(90rpx) scale(1.035); }
}

@keyframes waterfall-stream { to { background-position: 0 44rpx; } }
@keyframes panorama-mist { to { transform: translateX(12%) translateY(-5%); opacity: .24; } }
@keyframes story-water-current { to { background-position: 120rpx 0; } }
@keyframes theatre-ripple {
  0% { transform: translateX(-50%) scale(.44); opacity: 0; }
  18% { opacity: .72; }
  100% { transform: translateX(-50%) scale(1.12); opacity: 0; }
}

@keyframes book-float {
  0%, 100% { margin-top: 0; }
  50% { margin-top: -14rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .story-book,
  .pan-wave,
  .pan-waterfall,
  .pan-mist,
  .story-scene-water,
  .theatre-ripple {
    animation: none;
  }
}
