page,
.reader-page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #071f2c;
  color: #fff8e8;
}

.reader-pan { width: 100%; height: 100vh; white-space: nowrap; }
.reader-world {
  position: relative;
  display: inline-block;
  width: 177.78vh;
  min-width: 1500rpx;
  height: 100vh;
  overflow: hidden;
  white-space: normal;
}

.reader-background,
.reader-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.reader-background { filter: saturate(1.08) brightness(.98); }
.reader-shade {
  z-index: 1;
  background:
    linear-gradient(90deg, rgba(2,16,28,.86), rgba(4,25,38,.58) 31%, rgba(4,23,35,.06) 58%, rgba(2,15,26,.08)),
    linear-gradient(180deg, rgba(2,15,27,.38), transparent 35%, transparent 74%, rgba(2,15,26,.54));
}

.reader-character,
.reader-prop {
  position: absolute;
  z-index: 3;
  pointer-events: none;
  transform-origin: 50% 90%;
  filter: drop-shadow(0 28rpx 28rpx rgba(0, 17, 29, .48));
}
.reader-character {
  left: 59%;
  bottom: 4%;
  width: 25%;
  height: 66%;
  animation: reader-character-float 5.4s ease-in-out infinite;
}
.reader-prop {
  left: 49%;
  bottom: 10%;
  width: 13%;
  height: 24%;
  animation: reader-prop-float 4.2s ease-in-out infinite -1.1s;
}

.reader-topbar {
  position: fixed;
  z-index: 12;
  top: calc(env(safe-area-inset-top) + 112rpx);
  left: 22rpx;
  right: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  pointer-events: none;
}
.reader-leading,
.reader-tabs { display: flex; align-items: center; gap: 8rpx; pointer-events: auto; }
.glass-button,
.reader-tabs {
  border: 1rpx solid rgba(255,255,255,.42);
  background: linear-gradient(145deg, rgba(255,255,255,.25), rgba(213,240,250,.08));
  box-shadow: inset 0 2rpx 2rpx rgba(255,255,255,.25), 0 12rpx 36rpx rgba(0,18,38,.24);
  backdrop-filter: blur(20rpx);
}
button::after { border: 0; }
.back-button,
.orientation-button {
  width: auto;
  margin: 0;
  padding: 11rpx 17rpx;
  border-radius: 999rpx;
  color: #fff8e8;
  font-size: 19rpx;
  line-height: 1.4;
  white-space: nowrap;
}
.back-button { min-width: 116rpx; }
.orientation-button { min-width: 134rpx; color: #e9fff7; }
.reader-tabs { padding: 6rpx; border-radius: 999rpx; }
.reader-tab {
  width: auto;
  min-width: 100rpx;
  margin: 0;
  padding: 10rpx 12rpx;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: rgba(255,248,230,.78);
  font-size: 18rpx;
  line-height: 1.35;
}
.reader-tab.active { color: #fff; background: rgba(255,255,255,.26); box-shadow: inset 0 1rpx rgba(255,255,255,.38); }
.stage-tab { color: #aef1e6; }

.copy-scroll {
  position: absolute;
  z-index: 5;
  left: 30rpx;
  top: calc(env(safe-area-inset-top) + 292rpx);
  bottom: 36rpx;
  width: 680rpx;
  max-width: 86vw;
}
.copy-panel {
  width: 100%;
  min-height: 840rpx;
  margin: 10rpx 0 60rpx;
  padding: 44rpx 40rpx 58rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 34rpx;
  background: linear-gradient(145deg, rgba(3,22,36,.5), rgba(5,34,49,.14));
  box-shadow: 0 30rpx 90rpx rgba(0,18,34,.34);
  backdrop-filter: blur(13rpx);
}
.chapter { color: #bcefe6; font-size: 22rpx; letter-spacing: .1em; }
.story-title {
  margin: 16rpx 0 38rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 58rpx;
  line-height: 1.3;
  letter-spacing: .1em;
  text-shadow: 0 4rpx 18rpx rgba(0,18,31,.8);
}
.paragraph {
  margin-bottom: 32rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  line-height: 2;
  letter-spacing: .03em;
  text-shadow: 0 3rpx 12rpx rgba(0,18,30,.82);
}
.bamboo-panel {
  background:
    repeating-linear-gradient(90deg, rgba(237,207,153,.13) 0 44rpx, rgba(255,235,193,.2) 45rpx, rgba(125,91,51,.26) 48rpx, rgba(239,217,174,.1) 51rpx),
    linear-gradient(145deg, rgba(31,50,48,.5), rgba(117,91,50,.24));
  border-top: 9rpx solid rgba(207,170,100,.66);
  border-bottom: 9rpx solid rgba(207,170,100,.66);
}
.classic-source { margin-bottom: 38rpx; color: #f1dba8; font-size: 23rpx; letter-spacing: .13em; }
.classic-line { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 16rpx 5rpx; margin-bottom: 40rpx; }
.classic-token { min-width: 50rpx; display: flex; flex-direction: column; align-items: center; }
.classic-token.punctuation { min-width: 22rpx; }
.pinyin { min-height: 32rpx; color: #efd69e; font-size: 19rpx; line-height: 1.35; }
.han { font-family: "Songti SC", "STSong", serif; font-size: 41rpx; line-height: 1.35; color: #fff2ce; }
.reader-state { padding: 80rpx 0; font-size: 27rpx; line-height: 1.8; text-align: center; }
.retry { width: auto; margin: 20rpx auto 0; padding: 10rpx 26rpx; border-radius: 999rpx; color: #fff; }

@keyframes reader-character-float {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(-.6deg) scale(1); }
  50% { transform: translate3d(0, -18rpx, 0) rotate(.8deg) scale(1.018); }
}
@keyframes reader-prop-float {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(1deg); }
  50% { transform: translate3d(8rpx, -14rpx, 0) rotate(-2deg); }
}

@media (orientation: landscape) {
  .reader-world { width: 100vw; min-width: 100vw; }
  .reader-topbar {
    top: calc(env(safe-area-inset-top) + 12px);
    left: 14px;
    right: 98px;
    flex-direction: row;
    align-items: center;
    gap: 7px;
  }
  .reader-leading,
  .reader-tabs { gap: 5px; }
  .back-button,
  .orientation-button {
    min-width: 72px;
    padding: 6px 10px;
    font-size: 12px;
  }
  .orientation-button { min-width: 84px; }
  .reader-tabs { padding: 4px; }
  .reader-tab {
    min-width: 62px;
    padding: 6px 8px;
    font-size: 12px;
  }
  .copy-scroll { left: 18px; top: 70px; bottom: 14px; width: 41vw; }
  .copy-panel {
    min-height: calc(100vh - 88px);
    margin: 4px 0 24px;
    padding: 18px 22px 26px;
    border-radius: 22px;
  }
  .chapter { font-size: 13px; }
  .story-title { margin: 8px 0 18px; font-size: 28px; }
  .paragraph { margin-bottom: 16px; font-size: 15px; line-height: 1.8; }
  .classic-source { margin-bottom: 20px; font-size: 13px; }
  .classic-line { gap: 9px 3px; margin-bottom: 22px; }
  .classic-token { min-width: 27px; }
  .classic-token.punctuation { min-width: 12px; }
  .pinyin { min-height: 17px; font-size: 11px; }
  .han { font-size: 24px; }
  .reader-character { left: 63%; width: 22%; }
  .reader-prop { left: 53%; width: 11%; }
}
