<view class="rotate-gate" wx:if="{{!previewOverride}}">
  <view class="rotate-device">↻</view>
  <view class="rotate-title">请横置手机</view>
  <view class="rotate-copy">无手势上传测试仅在横屏中展示</view>
  <button class="glass-button rotate-preview" bindtap="previewStage">继续预览舞台</button>
</view>

<view class="stage-page">
  <image class="stage-theme" src="{{currentTheme.image}}" mode="scaleToFill" />
  <image class="stage-fallback" src="{{sceneImage}}" mode="aspectFill" style="{{currentTheme.openingStyle}}" />
  <canvas type="2d" id="waterCanvas" class="water-canvas" style="{{currentTheme.openingStyle}}"></canvas>
  <view class="stage-puppets motion-{{stageMotion}}">
    <image
      wx:for="{{puppetLayers}}"
      wx:key="id"
      class="puppet-layer asset-{{item.id}} layer-{{item.type}} {{item.id == activeFocusId ? 'is-focus' : ''}} {{item.attached ? 'is-attached' : ''}} {{item.throwing ? 'is-throwing' : ''}}"
      src="{{item.src}}"
      mode="aspectFit"
      style="{{item.style}}"
    />
    <view wx:if="{{actionRippleVisible}}" class="action-ripple" style="{{actionRippleStyle}}"></view>
  </view>
  <view class="front-water" aria-hidden="true"></view>
  <view class="stage-shade"></view>

  <view class="stage-topbar">
    <view class="stage-leading">
      <button class="glass-button back-button" bindtap="backReader">← 阅读</button>
      <view class="glass-button static-test-label">无手势上传测试</view>
    </view>
    <view class="scene-title" wx:if="{{currentScene}}">{{story.title}} · 第{{actIndex + 1}}幕 · {{currentScene.title}}</view>
    <text class="build-label">{{buildId}}</text>
  </view>

  <view class="gesture-guide {{completed ? 'is-complete' : ''}}" wx:if="{{currentScene}}">
    <view class="guide-label first-label">对照测试</view>
    <view class="guide-action">本版不启动摄像头与 VisionKit</view>
    <view class="guide-result">只验证图片素材、舞台与真机调试传输速度。</view>
  </view>

  <view class="theme-picker">
    <view wx:if="{{themeMenuOpen}}" class="theme-options">
      <button class="theme-option {{currentThemeIndex === index ? 'active' : ''}}" wx:for="{{themes}}" wx:key="name" data-index="{{index}}" bindtap="selectTheme">
        <image src="{{item.image}}" mode="aspectFill" />
        <text>{{item.name}}</text>
      </button>
    </view>
    <button class="glass-button theme-toggle" bindtap="toggleThemeMenu">水幕 · {{currentTheme.name}}⌃</button>
  </view>

  <view wx:if="{{loading}}" class="stage-state">正在布置水上戏台…</view>
  <view wx:elif="{{error}}" class="stage-state">{{error}}</view>
</view>
